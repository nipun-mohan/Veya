# Sarvam credentials stay only on the Veya gateway, never in the Flutter app.
SARVAM_API_KEY=replace-with-your-sarvam-key
SARVAM_STT_MODEL=saaras:v4
SARVAM_STYLE_MODEL=sarvam-105b-conversations

# Protects the internal operations dashboard at /internal/dashboard.
# Create a long random value and configure it in Secret Manager only.
VEYA_ADMIN_TOKEN=replace-with-a-long-random-admin-token

# MiniMoth is used only by /v1/auth/otp/*. Its WhatsApp-first / SMS-fallback
# key belongs in Secret Manager, never in the Flutter app or repository.
MINIMOTH_API_KEY=mm_test_or_mm_live_key

# Cloud Billing standard export dataset for the internal dashboard.
VEYA_BILLING_DATASET=veya_billing

# Subscription storage and Cashfree are intentionally configured only on the
# gateway. Never put either Cashfree key in the Android app.
VEYA_SUBSCRIPTIONS_COLLECTION=veya_subscriptions
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_MONTHLY_PRICE_INR=129
CASHFREE_TRIAL_PRICE_INR=9
CASHFREE_RETURN_URL=https://heyveya.app/subscription/return?subscription_id={subscription_id}
